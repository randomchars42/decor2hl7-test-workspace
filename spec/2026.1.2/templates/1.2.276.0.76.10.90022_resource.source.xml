            <attribute name="classCode" value="ACTI" datatype="cs" id="2.16.840.1.113883.2.6.60.4.9.264"/>
            <element name="pharm:quantity" datatype="IVL_PQ" minimumMultiplicity="0" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.2.6.60.4.9.133">
                <example caption="Wirkstärke von 10 mg Inhaltsstoff per ml des Medikaments">
                    <pharm:quantity>
                        <numerator xsi:type="PQ" value="10" unit="mg"/>
                        <denominator xsi:type="PQ" value="1" unit="ml"/>
                    </pharm:quantity>
                </example>
                <example caption="Wirkstärke des Inhaltsstoffs in 1 Einheit der verabreichten Medikation: 2% des Inhaltsstoffs">
