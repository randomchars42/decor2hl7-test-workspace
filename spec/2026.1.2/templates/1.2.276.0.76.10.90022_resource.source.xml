    <example caption="Arznei mit PZN und Wirkstoffangabe">
        <manufacturedMaterial classCode="MMAT" determinerCode="KIND">
        <!-- PZN -->
            <code code="4213974" codeSystem="1.2.276.0.76.4.6" displayName="RAMIPRIL STADA 5 mg"/>
            <pharm:formCode code="10211000" codeSystem="0.4.0.127.0.16.1.1.2.1" displayName="Capsule, soft" codeSystemName="EDQM"/>
            <pharm:asSpecializedKind classCode="GRIC">
                <pharm:generalizedMaterialKind classCode="MMAT">
            <!-- Pharmaceutical Substance (ATC Code)-->
                    <pharm:code code="C09AA05" codeSystem="2.16.840.1.113883.6.73" codeSystemName="WHO ATC"/>
                </pharm:generalizedMaterialKind>
            </pharm:asSpecializedKind>
            <pharm:ingredient classCode="ACTI">
                <pharm:quantity>
                    <numerator xsi:type="PQ" value="5" unit="mg"/>
                    <denominator xsi:type="PQ" value="1" unit="1"/>
                </pharm:quantity>
                <pharm:ingredient classCode="MMAT" determinerCode="KIND">
                    <pharm:code code="SUB10248MIG" codeSystem="0.4.0.127.0.16.1.1.2.1" displayName="RAMIPRIL" codeSystemName="XEVMPD Substance">
                        <originalText>Ramipril</originalText>
                    </pharm:code>
                </pharm:ingredient>
            </pharm:ingredient>
        </manufacturedMaterial>
    </example>
    <element name="hl7:manufacturedMaterial" minimumMultiplicity="1" maximumMultiplicity="1" isMandatory="true" id="2.16.840.1.113883.2.6.60.4.9.119">
        <attribute name="classCode" value="MMAT" datatype="cs" id="2.16.840.1.113883.2.6.60.4.9.243"/>
        <attribute name="determinerCode" value="KIND" datatype="cs" id="2.16.840.1.113883.2.6.60.4.9.244"/>
        <element name="hl7:code" datatype="CD" minimumMultiplicity="1" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.2.6.60.4.9.120">
            <desc language="de-DE">Pharmazentralnummer der Arznei, zugelassene nullFlavor:<ul>
                    <li>NI Arznei hat keine PZN</li>
                    <li>NA Arznei ist eine Rezeptur</li>
                    <li>UNK Arznei hat eine PZN, diese ist jedoch unbekannt</li>
                </ul>
            </desc>
            <example caption="Arznei mit PZN">
                <code code="10333719" codeSystem="1.2.276.0.76.4.6" displayName="Ibu-LysinHEXAL® 684 mg"/>
            </example>
            <example caption="Arznei hat keine PZN">
                <code nullFlavor="NI"/>
            </example>
            <example caption="Rezeptur (ohne PZN)">
                <code nullFlavor="NA">
                    <originalText>
                        <reference value="#rezeptur-17"/>
                    </originalText>
                </code>
            </example>
            <example caption="Arznei, unbekannte PZN">
                <code nullFlavor="UNK"/>
            </example>
            <vocabulary codeSystem="1.2.276.0.76.4.6"/>
            <attribute name="nullFlavor" datatype="cs" isOptional="true" id="2.16.840.1.113883.2.6.60.4.9.245">
                <vocabulary code="NA"/>
                <vocabulary code="NI"/>
                <vocabulary code="UNK"/>
            </attribute>
            <element name="hl7:originalText" datatype="ED" minimumMultiplicity="0" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.2.6.60.4.9.121">
                <element name="hl7:reference" datatype="TEL" minimumMultiplicity="1" maximumMultiplicity="1" isMandatory="true" id="2.16.840.1.113883.2.6.60.4.9.122">
                    <attribute name="value" id="2.16.840.1.113883.2.6.60.4.9.246">
                        <desc language="de-DE">z.B. #rezeptur-{generierteID}, z.B.: #rezeptur-1</desc>
                    </attribute>
                </element>
            </element>
            <element name="hl7:translation" datatype="CE" minimumMultiplicity="0" maximumMultiplicity="*" conformance="R" id="2.16.840.1.113883.2.6.60.4.9.123">
                <desc language="de-DE">Optionale Übersetzung des Codes in ein anderes Codesystem</desc>
            </element>
        </element>
        <element name="hl7:name" datatype="EN" minimumMultiplicity="1" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.2.6.60.4.9.124">
            <desc language="de-DE">Bezeichnung der Arznei<br/> Zugelassenes nullFlavor:<ul>
                    <li>NA Arznei ist eine Rezeptur</li>
                </ul>
            </desc>
            <example caption="Name der Arznei">
                <name>Limasin 500mg</name>
            </example>
            <example caption="Rezeptur ohne Handelsname">
                <name nullFlavor="NA"/>
            </example>
            <attribute name="nullFlavor" datatype="cs" isOptional="true" id="2.16.840.1.113883.2.6.60.4.9.247">
                <vocabulary code="NA"/>
            </attribute>
        </element>
        <element name="pharm:formCode" datatype="CE" minimumMultiplicity="0" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.2.6.60.4.9.125">
