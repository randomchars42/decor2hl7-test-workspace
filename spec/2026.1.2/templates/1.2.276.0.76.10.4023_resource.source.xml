              <element name="hl7:effectiveTime[@xsi:type='SXPR_TS'][hl7:comp[@xsi:type='IVL_TS']]" datatype="SXPR_TS" conformance="C" id="2.16.840.1.113883.3.1937.777.27.9.626">
