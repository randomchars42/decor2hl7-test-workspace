                    <desc language="de-DE">Einnahme einmalig / Einnahmezeitpunkt unbekannt</desc>
                    <example caption="Einnahme einmalig">
                        <effectiveTime value="20170404"/>
                    </example>
                    <example caption="Einnahmezeitpunkt unbekannt">
