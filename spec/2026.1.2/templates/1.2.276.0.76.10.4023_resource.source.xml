                    </example>
                </element>
                <element name="hl7:effectiveTime[@xsi:type='EIVL_TS']" datatype="EIVL_TS" conformance="C" id="2.16.840.1.113883.2.6.60.4.9.727">
                    <desc language="de-DE">Zeitelement zur Aufnahme des Einnahmezeitpunkts, ausgedrückt als Ergeignis, ggf. mit Offset</desc>
                    <example caption="mittags 10 mg">
    <effectiveTime xsi:type="EIVL_TS">
        <event code="CD"/>
    </effectiveTime>
    <doseQuantity value="10" unit="mg"/>
</example>
                    <example caption="morgens 1 (Stück)">
    <effectiveTime xsi:type="EIVL_TS">
        <event code="CM"/>
    </effectiveTime>
    <doseQuantity value="1" unit="{Stück}"/>
</example>
                    <example caption="abends 1-2 (Hübe)">
    <effectiveTime xsi:type="EIVL_TS">
        <event code="CV"/>
    </effectiveTime>
    <doseQuantity>
        <low value="1" unit="{Hübe}"/>
        <high value="2" unit="{Hübe}"/>
    </doseQuantity>
</example>
                    <example caption="30 Minuten nach dem Abendessen 1 Stück">
    <effectiveTime xsi:type="EIVL_TS">
        <event code="PCV"/>
        <offset value="30" unit="min"/>
    </effectiveTime>
    <doseQuantity value="1" unit="{Stück}"/>
</example>
