    <example type="neutral" caption="Start der Therapie 12. Oktober 2014 13:01 Uhr, Verlegungs-/Entlassungszeitpunkt 13:45 Uhr">
                <documentationOf typeCode="DOC">
                    <serviceEvent classCode="ACT" moddCode="EVN">
                        <effectiveTime>
                            <!-- Zeitpunkt Therapiebeginn (Datum und Zeit) -->
                            <low value="201410121301"/>
                        </effectiveTime>
                        <performer typeCode="PRF">
                            <functionCode code="ATTPHYS" codeSystem="2.16.840.1.113883.5.88" displayName="admitting physician"/>
                            <!-- Erster Arzt, Arztkontakt Beginn und Ende -->
                            <time>
                                <!-- Begin des Arztkontaktes -->
                                <low value="201410121306"/>
                            </time>
                            <assignedEntity classCode="ASSIGNED">
                                <id nullFlavor="NA"/>
                            </assignedEntity>
                        </performer>
                    </serviceEvent>
                </documentationOf>
            </example>
