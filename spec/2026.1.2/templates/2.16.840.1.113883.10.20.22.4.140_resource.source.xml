                            <desc language="en-US">This participantRole MAY contain zero or one [0..1] code, which SHOULD be selected from ValueSet Healthcare Provider Taxonomy (HIPAA) urn:oid:2.16.840.1.114222.4.11.1066 DYNAMIC (CONF:1098-32637).</desc>
                            <item label="CONF:1098-32637"/>
                            <vocabulary valueSet="2.16.840.1.114222.4.11.1066"/>
                        </element>
                    </element>
                </element>
                <element name="cda:entryRelationship" minimumMultiplicity="0" maximumMultiplicity="*" id="2.16.840.1.113883.3.1937.99.3.9.3628">
                    <desc language="en-US">MAY contain zero or more [0..*] entryRelationship (CONF:1098-31604) such that it<p/>The following entryRelationship represents whether the referral is for full or shared care.</desc>
                    <item label="CONF:1098-31604"/>
