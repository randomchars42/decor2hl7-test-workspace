                    <attribute name="typeCode" value="REFT" datatype="cs" id="2.16.840.1.113883.3.1937.99.3.9.3625">
                        <desc language="en-US">The participant, if present, SHALL contain exactly one [1..1] @typeCode="REFT" Referred to (CodeSystem: HL7ActRelationshipType urn:oid:2.16.840.1.113883.5.1002) (CONF:1098-32638).</desc>
                        <item label="CONF:1098-32638"/>
                    </attribute>
