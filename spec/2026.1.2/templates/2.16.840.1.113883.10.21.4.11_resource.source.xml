                                <!-- 50ml per ampoule -->
                                <containerPackagedProduct classCode="CONT" determinerCode="KIND">
                                    <!-- .. -->
                                    <formCode code=" " displayName="Ampoules" codeSystem=" " codeSystemName=" "/>
                                    <asContent>
