                                        <quantity value="5"/>
                                        <containerPackagedProduct classCode="CONT" determinerCode="KIND">
                                            <!-- .. -->
                                        </containerPackagedProduct>
                                    </asContent>
                                </containerPackagedProduct>
                            </asContent>
                        </example>
                        <example type="neutral" caption="Packaged Medicinal Product with multiple layers packaging">
                            <asContent classCode="CONT">
                                <containerPackagedProduct>
                                    <!-- Inner Package -->
                                    <code codeSystem="..." code="..." displayName="..."/>
                                    <asContent>
                                        <containerPackagedProduct>
