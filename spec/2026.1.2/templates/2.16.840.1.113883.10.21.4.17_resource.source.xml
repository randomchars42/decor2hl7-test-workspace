                <element name="pharmhl7:code" datatype="CE" minimumMultiplicity="0" maximumMultiplicity="1" id="2.16.840.1.113883.3.1937.777.15.9.10902">
                    <desc language="en-US">
                        <div class="yui-wk-div">It represents the code of the Package Item or of the Packaged Medicinal Product.</div>
                        <div class="yui-wk-div">If this is also the most outer &lt;pharmhl7:containerPackagedProduct&gt; than this element can be used to convey the Packaged Medicinal Product ID.</div>
                    </desc>
                </element>
                <element name="pharmhl7:name" datatype="EN" minimumMultiplicity="0" maximumMultiplicity="*" id="2.16.840.1.113883.3.1937.777.15.9.10903">
                    <desc language="en-US">
                        <div>It represents the Name of the Package Item or of the Packaged Medicinal Product.</div>
                        <div>If this is also the most outer &lt;pharmhl7:containerPackagedProduct&gt; than this element can be used for the brand name.</div>
                    </desc>
                </element>
                <element name="pharmhl7:formCode" datatype="CE" minimumMultiplicity="0" maximumMultiplicity="1" id="2.16.840.1.113883.3.1937.777.15.9.10904">
                    <desc language="en-US">This element encodes the type of the most inner package item or of the or the Packaged Medicinal Product.<br clear="none"/>
                    </desc>
                </element>
                <element name="pharmhl7:capacityQuantity" datatype="PQ" minimumMultiplicity="0" maximumMultiplicity="1" id="2.16.840.1.113883.3.1937.777.15.9.10905">
                    <desc language="en-US">Captures the number of product units the package would contain if fully loaded.<br clear="none"/>
