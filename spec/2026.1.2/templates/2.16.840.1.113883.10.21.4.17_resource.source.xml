            <element name="pharmhl7:containerPackagedProduct" minimumMultiplicity="1" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.3.1937.777.15.9.10899">
                <desc language="en-US"/>
                <attribute name="classCode" value="CONT" datatype="cs" id="2.16.840.1.113883.3.1937.777.15.9.10900"/>
