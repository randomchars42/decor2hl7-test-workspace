<template xmlns:json="http://www.json.org" xmlns:cpm="urn:hl7-org:cpm" xmlns:cda="urn:hl7-org:v3" xmlns:hl7="urn:hl7-org:v3" xmlns:pharm="urn:hl7-org:pharm" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="2.16.840.1.113883.10.22.4.31" name="IPSEntryInternalReference" displayName="IPS Internal Reference" statusCode="pending" versionLabel="STU1" effectiveDate="2017-05-02T00:00:00" url="http://art-decor.org/decor/services/" ident="hl7ips-" cpm:dummy-1="urn:hl7-org:cpm" pharm:dummy-2="urn:hl7-org:pharm" xml:dummy-3="http://www.w3.org/XML/1998/namespace" hl7:dummy-default="urn:hl7-org:v3" cda:dummy-5="urn:hl7-org:v3" xsi:dummy-6="http://www.w3.org/2001/XMLSchema-instance">
            <desc language="en-US">This template is used to reference (point to) information contained in other entries within the same document.</desc>
            <classification type="cdaentrylevel"/>
            <relationship type="ADAPT" template="1.3.6.1.4.1.19376.1.5.3.1.4.4.1" flexibility="2013-12-20T00:00:00"/>
            <example caption="Reference to an uncoded element">
                <act classCode="ACT" moodCode="cs">
                    <templateId root="2.16.840.1.113883.10.22.4.31"/>
                    <id root="1.2.3.999" extension="__example only__"/>
                    <code nullFlavor="NA"/>
                </act>
            </example>
            <element name="hl7:act" conformance="R" id="2.16.840.1.113883.3.1937.777.11.9.456">
                <attribute name="classCode" value="ACT" datatype="cs" id="2.16.840.1.113883.3.1937.777.11.9.457"/>
                <attribute name="moodCode" datatype="cs" id="2.16.840.1.113883.3.1937.777.11.9.458">
                    <desc language="en-US">The @moodCode of the reference SHALL match the @moodCode of the referenced element</desc>
                </attribute>
                <let name="refMoodCode" value="@moodCode"/>
                <let name="refID" value="concat(hl7:id[1]/@root,'#',hl7:id[1]/@extension)"/>
                <let name="refCode" value="concat(hl7:code[1]/@code,'#',hl7:code[1]/@codeSystem)"/>
                <let name="reffedObject" value="(ancestor::hl7:ClinicalDocument//*:id[concat(@root,'#',@extension)=$refID][not(preceding-sibling::hl7:templateId/@root='1.3.6.1.4.1.19376.1.5.3.1.4.4.1')]/parent::*)[1]"/>
                <assert role="error" test="not(exists($reffedObject)) or $reffedObject[@moodCode=$refMoodCode]">The @moodCode of the reference SHALL match the @moodCode of the referenced element</assert>
                <assert role="error" test="exists($reffedObject)">The root and extension attributes SHALL identify an element defined elsewhere in the same document.</assert>
                <assert role="error" test="not(exists($reffedObject)) or ($reffedObject[not(*:code/@code)] and hl7:code[@nullFlavor='NA']) or $reffedObject/*:code[concat(@code,'#',@codeSystem)=$refCode]">The code of the reference SHALL match the code of the referenced element</assert>
                <element name="hl7:templateId" datatype="II" minimumMultiplicity="1" maximumMultiplicity="1" conformance="R" isMandatory="true" id="2.16.840.1.113883.3.1937.777.13.9.215">
                    <attribute name="root" value="2.16.840.1.113883.10.22.4.31" datatype="uid" id="2.16.840.1.113883.3.1937.777.13.9.216"/>
                </element>
                <element name="hl7:id" datatype="II" minimumMultiplicity="1" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.3.1937.777.11.9.461">
                    <desc language="en-US">This element shall be present. The root and extension attributes shall identify an element defined elsewhere in the same document.</desc>
                </element>
                <element name="hl7:code" datatype="CD" minimumMultiplicity="1" maximumMultiplicity="1" conformance="R" id="2.16.840.1.113883.3.1937.777.11.9.462">
                    <desc language="en-US">This element shall be present. It shall be valued when the internal reference is to element that has a &lt;code&gt; element, and shall have the same attributes as the &lt;code&gt; element in the act it references. If the element it references does not have a &lt;code&gt; element, then the nullFlavor attribute should be set to "NA".</desc>
                    <attribute name="nullFlavor" value="NA" datatype="cs" isOptional="true" id="2.16.840.1.113883.3.1937.777.11.9.463"/>
                </element>
            </element>
        </template>