            <implementation shortName="generische_pathologischanatomische_einzelbeobachtung" markdown="Atomic unit of a Generic AP observation, coded or as measurement value. &#xA;Each generic observation must have a textual part for human readibility."/>
            <inherit ref="2.16.840.1.113883.2.6.60.6.2.65" effectiveDate="2015-10-26T08:38:19" prefix="psr-" datasetId="2.16.840.1.113883.2.6.60.6.1.1" datasetEffectiveDate="2015-06-18T18:17:24" datasetStatusCode="draft" datasetVersionLabel="2.0" iType="item" iStatusCode="draft" iEffectiveDate="2015-10-26T08:38:19" iddisplay="psr-dataelement-65" refdisplay="psr-dataelement-65" localInherit="true"/>
            <name language="de-DE" lastTranslated="2017-06-29T11:49:58">Generische pathologisch-anatomische Einzelbeobachtung</name>
            <desc language="de-DE" lastTranslated="2017-06-29T12:02:35">
                                <span style="color: rgb(51, 51, 51); font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 12px;">Semantisch annotierte atomare Einheit einer generischen pathologisch-anatomische Beobachtung</span>
                            </desc>
            <rationale language="de-DE">
                                <span style="color: rgb(51, 51, 51); font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 12px;">Jede Beobachtung, die als Bestandteil einer pathologisch-anatomischen Untersuchung im Befundbericht erwähnt ist, kann zusätzlich zur textuellen Erwähnung auch semantisch annotiert, d.h. mit einem Code und einem Value in den Bericht maschinenlesbar aufgenommen
                                    werden.</span>
                                <br clear="none" style="color: rgb(51, 51, 51); font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 12px;"/>
                                <span style="color: rgb(51, 51, 51); font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 12px;">Die semantische Annotation kann durch beliebige Terminologiesysteme erfolgen, LOINC (für die Kodierung der Beobachtung) und SNOMED-CT (für die Kodierung des Beobachtungsergebnisses, falls es sich nicht um einen Messwert handelt), sind bevorzugt zu verwenden.
                                    Codierungsregeln für diese beiden Referenzterminologien sind unter dem HL7 TermInfo-Project (für CDA) oder unter  "Practical Guidance on Uses of SNOMED CT and LOINC" (https://confluence.ihtsdotools.org/display/DOCLOINC/5.2+Practical+Guidance+on+Uses+of+SNOMED+CT+and+LOINC)</span>
                                <br clear="none" style="color: rgb(51, 51, 51); font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 12px;"/>
                                <span style="color: rgb(51, 51, 51); font-family: Arial, Helvetica, Geneva, sans-serif; font-size: 12px;"> hinterlegt.</span>
                                <br clear="none"/>
                            </rationale>
            <valueDomain type="code">
