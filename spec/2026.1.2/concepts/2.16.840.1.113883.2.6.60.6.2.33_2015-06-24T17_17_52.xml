        <concept id="2.16.840.1.113883.2.6.60.6.2.49" statusCode="draft" effectiveDate="2015-07-30T12:32:44" type="group" iddisplay="psr-dataelement-49" shortName="auftragsid">
            <implementation shortName="auftragsid" markdown="Identification of the order, issued by the Ordering Physician (Order Placer). If more than one Order is placed at the same time, those multiple orders are grouped by the Order placer group ID."/>
            <name language="de-DE" lastTranslated="2017-06-21T09:47:44">Auftrags-ID</name>
            <desc language="de-DE" lastTranslated="2017-06-21T09:48:02">ID des Untersuchungsauftrags.</desc>
            <concept id="2.16.840.1.113883.2.6.60.6.2.82" statusCode="draft" effectiveDate="2016-09-20T09:14:19" type="item" iddisplay="psr-dataelement-82" shortName="auftragsgruppenid">
                <implementation shortName="auftragsgruppenid" markdown="The ID of a laboratory request, that is a set of orders placed together by a ward and/or a physician to one or more laboratories for a patient, to be performed on one or more specimens collected from this patient. Any message exchanged between Order Filler and Order Placer or Order Result Tracker, is carrying zero or one Order Group. "/>
                <name language="de-DE" lastTranslated="2017-06-21T09:48:47">Auftragsgruppen-ID</name>
                <desc language="de-DE" lastTranslated="2017-06-21T09:49:14">ID einer Auftragsgruppe, bestehend aus mehreren Untersuchungsaufträgen</desc>
                <valueDomain type="identifier"/>
            </concept>
            <concept id="2.16.840.1.113883.2.6.60.6.2.81" effectiveDate="2016-09-20T09:13:26" statusCode="draft" type="item" iddisplay="psr-dataelement-81" shortName="auftragsid_des_auftraggebers">
                <implementation shortName="auftragsid_des_auftraggebers" markdown="This is the ID the Order Placer sent."/>
                <name language="de-DE" lastTranslated="2017-06-21T09:50:05">Auftrags-ID des Auftraggebers</name>
                <desc language="de-DE" lastTranslated="2017-06-21T09:50:26">Auftrags-ID vom Auftraggeber vergeben</desc>
                <source language="de-DE">Placer order number, HL7 2.x</source>
                <valueDomain type="identifier">
                    <example type="neutral">KHXX_ENDO_18.123451</example>
                </valueDomain>
            </concept>
            <concept id="2.16.840.1.113883.2.6.60.6.2.83" effectiveDate="2016-09-20T09:15:14" statusCode="draft" type="item" iddisplay="psr-dataelement-83" shortName="auftragsid_des_auftragnehmers">
                <implementation shortName="auftragsid_des_auftragnehmers" markdown="This is the ID of the Order, coming from the Order Placer, issued by the Order Filler in the Lab. If only one specimen is sent, the Order filler ID may be the same as  the Case ID (Accession number)."/>
                <name language="de-DE" lastTranslated="2017-06-21T09:51:23">Auftrags-ID des Auftragnehmers </name>
                <desc language="de-DE" lastTranslated="2017-06-21T09:51:59">Auftrags-ID vom Auftragnehmer (Pathologie) vergeben, oft identisch mit Fall-Nr.</desc>
                <source language="de-DE">Filler order number HL7 2.x</source>
                <valueDomain type="identifier">
                    <example type="neutral">E18-321654</example>
                </valueDomain>
            </concept>
            <concept id="2.16.840.1.113883.2.6.60.6.2.84" effectiveDate="2016-09-20T09:16:59" statusCode="draft" type="group" iddisplay="psr-dataelement-84" shortName="arbeitsauftrag">
                <implementation shortName="arbeitsauftrag" markdown="Work order in the Lab, i.e. the process for grossing, embedding, sectioning, and staining, for one specimen (part), issued by the Order filler."/>
                <name language="de-DE" lastTranslated="2017-06-21T09:57:50">Arbeitsauftrag</name>
                <desc language="de-DE" lastTranslated="2017-06-21T09:53:42">Laborauftrag für eine komplexe Leistung, z.B. immunhistochemische Untersuchung. Umfasst Zuschnitt, Einbettung, Schneiden und Färbung, </desc>
                <source language="de-DE">Work Order/Requested Procedure, PaLM TF 1, LTW, Path TF1 APW</source>
                <concept id="2.16.840.1.113883.2.6.60.6.2.90" effectiveDate="2016-11-06T11:34:13" statusCode="draft" type="item" iddisplay="psr-dataelement-90" shortName="angeforderte_prozedur">
                    <implementation shortName="angeforderte_prozedur" markdown="In anatomic Pathology, a Requested Procedure (or imaging Study) is identified by its unique Accession Number (see this term in the data set). A Requested Procedure is attached to an Order (and is equivalent to a Work order in LAB).&#xA;&#xA;As expressed in DICOM Supplement 122 the concept of accession in Anatomic Pathology has been determined to be sufficiently equivalent to an accession in Radiology so that the existing Accession Number at the Study level may be reused for the same purpose and with essentially the existing definition. &#xA;&#xA;A Requested Procedure may involve more than one acquisition modality (e.g. gross imaging, microscopic imaging) and/or more than one specimen, in which cases the Study will include more than one Series. "/>
                    <name language="de-DE" lastTranslated="2017-06-21T09:54:39">Angeforderte Prozedur</name>
                    <desc language="de-DE" lastTranslated="2017-06-21T09:56:04">Angeforderte Prozedur im Arbeits-Auftrag.</desc>
                    <valueDomain type="code">
                        <conceptList id="2.16.840.1.113883.2.6.60.6.2.90.20161106113413.0"/>
                        <example type="neutral">40923002 | Tissue processing technique, routine, embed, cut and stain, per surgical specimen (procedure) |</example>
                    </valueDomain>
                </concept>
                <concept id="2.16.840.1.113883.2.6.60.6.2.100" statusCode="draft" effectiveDate="2017-01-17T15:02:12" type="item" iddisplay="psr-dataelement-100" shortName="arbeitsauftragsid">
                    <implementation shortName="arbeitsauftragsid" markdown="This is the ID for the Work Order"/>
                    <name language="de-DE" lastTranslated="2017-06-21T09:56:50">Arbeitsauftrags-ID</name>
                    <desc language="de-DE" lastTranslated="2017-06-21T09:57:00">Arbeitsauftrags-ID</desc>
                    <valueDomain type="identifier"/>
                </concept>
            </concept>
            <concept id="2.16.840.1.113883.2.6.60.6.2.101" statusCode="draft" effectiveDate="2017-01-17T15:04:00" type="group" iddisplay="psr-dataelement-101" shortName="arbeitsschrittauftrag">
                <implementation shortName="arbeitsschrittauftrag" markdown="A single work order step in the Lab, as Specimen work order step for the Lab processors (e.g. immunostainer), issued by the LIS (Automation manager)"/>
                <name language="de-DE" lastTranslated="2017-06-21T09:58:30">Arbeitsschrittauftrag</name>
                <desc language="de-DE" lastTranslated="2017-06-21T09:58:57">Auftrag für einzelnen Arbeitsschritt, z.B. HE-Färbung</desc>
                <concept id="2.16.840.1.113883.2.6.60.6.2.89" statusCode="draft" effectiveDate="2016-11-06T09:40:04" type="item" iddisplay="psr-dataelement-89" shortName="arbeitsschritt">
                    <implementation shortName="arbeitsschritt" markdown="For each Requested Procedure (see this in the dataset), the basic or special techniques involved in the processing of the corresponding specimen(s) may require different devices (automatons, image acquisition modality, etc). Each Requested Procedure may contain one or more Procedure Steps (Work Order and Specimen Work Order Step).  A Procedure Step is the smallest unit of work in the workflow that is scheduled (work to do) and/or performed (work done) by a person or a machine (automaton, image acquisition modality, etc) on an object (specimen, tissue sample, tissue section, etc) "/>
                    <name language="de-DE" lastTranslated="2017-06-21T10:01:23">Arbeitsschritt</name>
                    <desc language="de-DE" lastTranslated="2017-06-21T10:02:05">einzelner Arbeitsschritt</desc>
                    <valueDomain type="string"/>
                </concept>
